[virtual=x86_64,multiboot] boot = {
    startup-x86 -D 8250
    PATH=/proc/boot:/bin:/usr/bin LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib procnto-smp-instr
}

[+script] startup-script = {
    PATH=/proc/boot:/bin:/usr/bin
    LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib
    reopen /dev/text

    display_msg "=== SECPOL_AUDIT_BLAST=@MUTANT_NAME@ ==="
    secpolpush /proc/boot/secpol.bin

    on -T secpol_sentry_t -u 25:25 /proc/boot/secpol_sentry -t 8 &
    waitfor /dev/secpol_sentry 3

    on -T can_hal_t -u 23:23 /proc/boot/can_server &
    waitfor /dev/name/local/can_ctrl 5

    display_msg "=== PIDIN_BEGIN ==="
    pidin -f a_n
    display_msg "=== PIDIN_END ==="

    on -T ivi_ui_t -u 31:31 /proc/boot/kprobe --origin ivi_ui_t --settypeid diag_helper_t,can_hal_t --connect can_ctrl --attach can_ctrl
    on -T diag_helper_t -u 29:29 /proc/boot/kprobe --origin diag_helper_t --settypeid can_hal_t,ivi_ui_t --connect can_ctrl --attach can_ctrl
    on -T audit_reader_t -u 26:26 /proc/boot/kprobe --origin audit_reader_t --settypeid can_hal_t,diag_helper_t --connect can_ctrl --attach can_ctrl

    waitfor /dev/secpol_sentry_done 10
    display_msg "=== SECPOL_AUDIT_DONE ==="
}

/proc/boot/secpol.bin=@SECPOL_BIN@

[autoso=add]
/usr/lib/ldqnx-64.so.2=ldqnx-64.so.2
libc.so.6
libsecpol.so
libsecpolev.so
/proc/boot/secpolpush=secpolpush
/proc/boot/on=on
/proc/boot/pidin=pidin
/proc/boot/secpol_sentry=build/secpol_sentry
/proc/boot/can_server=build/can_server
/proc/boot/kprobe=build/kprobe
