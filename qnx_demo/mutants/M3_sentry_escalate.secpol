# Mutant M3_sentry_escalate: Vulnerable 2-hop escalation policy instrumented with secpol_sentry
#   ivi_ui_t -> diag_helper_t -> can_hal_t (mem_phys, io, /dev/name/local/can_ctrl)
# Static prediction: CRITICAL ESCALATION_CHAIN (2-hop: ivi_ui_t -> diag_helper_t -> can_hal_t)
# Runtime prediction:
#   - DIRECT_RESULT=DENIED, HOP1_SPAWN=OK, HOP2_SPAWN=OK, HOP2_RESULT=GRANTED
#   - libsecpolev captures settypeid OK hops + SECPOLEV_ALERT multi_hop_chain
#   - SENTRY_READ_AUTH=OK (audit_reader_t) and SENTRY_READ_UNAUTH=DENIED (ivi_ui_t)

class sentry { read_events };

type slogger2_t;
type can_hal_t;
type planner_t;
type diag_helper_t;
type ivi_ui_t;
type secpol_sentry_t;
type audit_reader_t;

allow_attach slogger2_t /dev/slog2;
allow slogger2_t self:ability {
    nonroot
    pathspace
    public_channel
};

# name_attach(NULL, "can_ctrl", 0) registers at /dev/name/local/can_ctrl
allow_attach can_hal_t /dev/name/local/can_ctrl;
allow can_hal_t self:ability {
    nonroot
    mem_phys:0xfe000000-0xfe010000
    io
    pathspace
    public_channel
};
allow can_hal_t self : channel connect;

allow planner_t can_hal_t : channel connect;

# Hop 2: diag_helper_t can transition into can_hal_t
allow_attach diag_helper_t /dev/diag;
allow diag_helper_t self:ability {
    nonroot
    settypeid:can_hal_t
    gain_priv:mem_phys,io,channel_connect
};

# Hop 1: untrusted ivi_ui_t can spawn diag_helper_t
allow ivi_ui_t diag_helper_t : channel connect;
allow ivi_ui_t self:ability {
    nonroot
    settypeid:diag_helper_t
    gain_priv:pathspace,settypeid
};

# Native QNX 8.0 libsecpolev telemetry resource manager (`secpol_sentry`)
allow_attach secpol_sentry_t /dev/secpol_sentry;
allow_attach secpol_sentry_t /dev/name/local/_tracelog;
mount_point 0:0 r--r--r-- /dev/secpol_sentry;
allow secpol_sentry_t self:ability {
    nonroot
    pathspace
    public_channel
    trace
};

# Authorized telemetry reader: allowed both channel connect and custom `sentry read_events`
allow audit_reader_t secpol_sentry_t : channel connect;
allow audit_reader_t secpol_sentry_t : sentry read_events;

# Untrusted IVI UI can reach the device node, but lacks `sentry read_events`
# so secpol_check_permission() returns EACCES and emits a SECPOLEV custom-perm denial
allow ivi_ui_t secpol_sentry_t : channel connect;
