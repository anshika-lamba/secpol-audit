# QNX Neutrino 8.0 — 12-Service ADAS Blast Verification Policy (Remediated)
# Demonstrates:
#   1. Realistic 12-service automotive architecture (HAL, middleware, OTA, IVI, sentry)
#   2. Explicit QNX 8.0 channel-type override:
#        allow_attach can_hal_t /dev/name/local/can_ctrl can_chan_t;
#      (server process launches with `-T can_hal_t`, channel effective type is `can_chan_t`)
#   3. 2-hop privilege escalation chain:
#        ivi_ui_t -> diag_helper_t -> can_hal_t (mem_phys, io, /dev/name/local/can_ctrl)

class sentry { read_events };

type slogger2_t;
type secpol_sentry_t;
type can_hal_t;
type can_chan_t;
type lidar_drv_t;
type cam_drv_t;
type io_sock_t;
type perception_t;
type planner_t;
type ota_agent_t;
type diag_helper_t;
type ivi_ui_t;

allow_attach slogger2_t /dev/slog2;
allow slogger2_t self:ability {
    nonroot
    pathspace
    public_channel
};

allow_attach secpol_sentry_t /dev/secpol_sentry;
allow_attach secpol_sentry_t /dev/name/local/_tracelog;
mount_point 0:0 r--r--r-- /dev/secpol_sentry;
allow secpol_sentry_t self:ability {
    nonroot
    pathspace
    public_channel
    trace
};

# Explicit QNX 8.0 channel-type override: can_hal_t attaches /dev/name/local/can_ctrl as can_chan_t
allow_attach can_hal_t /dev/name/local/can_ctrl can_chan_t;
allow can_hal_t self:ability {
    nonroot
    mem_phys:0xfe000000-0xfe010000
    io
    pathspace
    public_channel
};
allow can_hal_t can_chan_t : channel connect;

allow_attach lidar_drv_t /dev/lidar0;
allow lidar_drv_t self:ability {
    nonroot
    mem_phys:0xfd000000-0xfd100000
    pathspace
};

allow_attach cam_drv_t /dev/cam0;
allow cam_drv_t self:ability {
    nonroot
    mem_phys:0xfc000000-0xfc100000
    pathspace
};

allow_attach io_sock_t /dev/socket;
allow io_sock_t self:ability {
    nonroot
    able_create
    pathspace
};

allow_attach perception_t /dev/perception;
allow perception_t { lidar_drv_t cam_drv_t } : channel connect;

# Legitimate planner connects to the overridden channel type `can_chan_t`
allow_attach planner_t /dev/secpol_probe_allow_planner;
allow planner_t self:ability {
    nonroot
    noinherit pathspace
};
allow planner_t { perception_t can_chan_t secpol_sentry_t } : channel connect;
allow planner_t secpol_sentry_t : sentry read_events;

allow ota_agent_t self:ability {
    nonroot
    noinherit pathspace
};
allow ota_agent_t { io_sock_t secpol_sentry_t } : channel connect;

# Hop 2 (VULNERABLE): diag_helper_t can transition to can_hal_t
allow_attach diag_helper_t /dev/diag;
allow diag_helper_t self:ability {
    nonroot
    noinherit pathspace
};

# Hop 1 (VULNERABLE): untrusted ivi_ui_t can spawn diag_helper_t
allow ivi_ui_t { io_sock_t diag_helper_t secpol_sentry_t } : channel connect;
allow ivi_ui_t self:ability {
    nonroot
    noinherit pathspace
};
