# Mutant M2_untyped_server: can_server launched WITHOUT `on -T can_hal_t`!
# Static prediction: UNTYPED_IFS_SERVICE (HIGH) on can_server
# Runtime prediction: RUNTIME_UNTYPED_PROCESS (CRITICAL) for can_server in pidin -f a_n

[virtual=x86_64,bios +compress] boot = {
    startup-x86 -D8250..115200
    PATH=/proc/boot:/bin:/usr/bin LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib procnto-smp-instr -v
}

[+script] startup-script = {
    display_msg "=== SECPOL_AUDIT_MUTANT=M2_untyped_server ==="
    PATH=/proc/boot:/bin:/usr/bin
    LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib

    secpolpush /etc/secpol.bin

    on -T slogger2_t -u 20:20 slogger2
    waitfor /dev/slog2 5

    # PLANTED FLAW: can_server launched untyped (missing `on -T can_hal_t`)!
    /proc/boot/can_server &
    waitfor /dev/name/local/can_ctrl 5

    display_msg "=== PIDIN_BEGIN ==="
    pidin -f a_n
    display_msg "=== PIDIN_END ==="

    on -T ivi_ui_t -u 31:31 /proc/boot/ivi_exploit
    sleep 1
    display_msg "=== SECPOL_AUDIT_DONE ==="
}

[type=link] /bin/sh=/proc/boot/ksh
[type=link] /dev/console=/dev/ser1

/etc/secpol.bin=build/M0_clean.secpol.bin

[data=copy]
/proc/boot/secpolpush=secpolpush
/proc/boot/slogger2=slogger2
/proc/boot/on=on
/proc/boot/pidin=pidin
/proc/boot/ksh=ksh
/proc/boot/can_server=build/can_server
/proc/boot/diag_helper=build/diag_helper
/proc/boot/ivi_exploit=build/ivi_exploit
